# Copy to .env.local (done automatically by `pnpm start`). Overrides .env, not committed.

# Your own app credentials from https://my.telegram.org/apps (must match the backend's).
VITE_API_ID=
VITE_API_HASH=

# Bridge backend origin. Empty = same origin as the page (open http://localhost:8000 through nginx,
# or the ngrok URL; always empty in a production build behind nginx). Set to http://localhost:3000
# to talk to the backend directly from the dev server on :5173 (no nginx, no tunnel) — then add
# http://localhost:5173 to the backend's CORS_ORIGINS.
VITE_BRIDGE_ORIGIN=
